<style>
  :root{
    --bg:        #0A0C14;
    --bg-2:      #0E1120;
    --panel:     rgba(255,255,255,0.045);
    --panel-2:   rgba(255,255,255,0.03);
    --panel-solid: #141828;
    --line:      rgba(255,255,255,0.09);
    --line-soft: rgba(255,255,255,0.06);
    --ink:       #F3F4FA;
    --ink-dim:   #9499B3;
    --ink-faint: #5C6180;
    --violet:    #8C7CFF;
    --violet-2:  #5B8DFF;
    --mint:      #3DDC97;
    --mint-dim:  #1F6B4C;
    --coral:     #FF7A9C;
    --gold:      #FFD700;
    --grad-brand: linear-gradient(135deg, #8C7CFF 0%, #5B8DFF 100%);
    --grad-mint:  linear-gradient(135deg, #3DDC97 0%, #29B7D8 100%);
    --radius:    22px;
    --radius-sm: 14px;
    --font-display: 'Sora', sans-serif;
    --font-mono:    'JetBrains Mono', monospace;
    --safe-top: env(safe-area-inset-top, 0px);
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }

  *{ margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color: transparent; }
  html, body{ background: var(--bg); color: var(--ink); font-family: var(--font-mono); overscroll-behavior-y: none; }
  body{ min-height: 100vh; padding-top: var(--safe-top); padding-bottom: calc(var(--safe-bottom) + 28px); background-image: radial-gradient(circle at 12% -8%, rgba(140,124,255,0.22), transparent 42%), radial-gradient(circle at 105% 18%, rgba(91,141,255,0.16), transparent 38%), radial-gradient(circle at 50% 100%, rgba(61,220,151,0.07), transparent 45%); background-attachment: fixed; }
  .hazard-strip{ height: 3px; width: 100%; background: var(--grad-brand); opacity: 0.85; position: fixed; top: 0; left: 0; z-index: 50;}
  .app{ max-width: 480px; margin: 0 auto; padding: 0 16px; transition: filter 0.3s ease; }

  /* VIP GİRİŞ STİLLERİ */
  #authScreen { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; padding: 20px; z-index: 1000; position: relative; }
  .auth-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 30px 20px; width: 100%; max-width: 360px; backdrop-filter: blur(18px); text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
  .auth-card h1 { font-family: var(--font-display); font-size: 24px; margin-bottom: 5px; background: var(--grad-brand); -webkit-background-clip: text; color: transparent; }
  .auth-input { width: 100%; background: var(--panel-2); border: 1px solid var(--line-soft); border-radius: var(--radius-sm); padding: 14px; color: var(--ink); font-family: var(--font-mono); font-size: 15px; margin-bottom: 12px; outline: none; }
  .btn-auth { width: 100%; background: var(--grad-brand); border: none; border-radius: 14px; color: #0A0C14; font-family: var(--font-display); font-weight: 700; font-size: 16px; padding: 15px; cursor: pointer; margin-top: 10px; }
  .btn-auth:disabled { opacity: 0.5; cursor: not-allowed; }
  #authError { color: var(--coral); font-size: 12px; margin-top: 15px; display: none; }
  #mainApp { display: none; } 

  /* ... REST OF YOUR CSS STYLES (KEEP EXISTING) ... */
  
